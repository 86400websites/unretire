# (Un)Retire — environment variable NAMES with fake placeholders.
# Copy to .env.local (gitignored) and fill real values yourself.
# NEVER commit a live env file. Agents never open .env.local.
# Rules: docs/ENV-VARS-SAFETY.md · Record of names: docs/TECH-ARCHITECTURE.md §6
#
# IMPORTANT — each name appears ONCE. A .env file cannot hold the same key twice;
# the last occurrence silently wins. Locally, use the TEST project values only.
# The test/production split lives in Vercel's per-environment scoping, not here:
#   Preview    -> unretire-test + Stripe Sandbox
#   Production -> unretire-prod + Stripe live

# --- Supabase (auth + database) — use the unretire-test values locally ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-TEST-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_FAKE_PLACEHOLDER
SUPABASE_SECRET_KEY=sb_secret_FAKE_PLACEHOLDER

# --- Stripe — use Sandbox (test-mode) values locally. Never a live key. ---
STRIPE_SECRET_KEY=sk_test_FAKE_PLACEHOLDER
STRIPE_PRICE_COURSE=price_FAKE_PLACEHOLDER_COURSE
STRIPE_PRICE_PREMIUM=price_FAKE_PLACEHOLDER_PREMIUM
STRIPE_WEBHOOK_SECRET=whsec_FAKE_PLACEHOLDER

# --- Mailchimp ---
MAILCHIMP_API_KEY=FAKE_PLACEHOLDER-us00
MAILCHIMP_LIST_ID=FAKE_PLACEHOLDER

# --- Site config ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_FORMSPREE_ENDPOINT=https://formspree.io/f/FAKE_PLACEHOLDER

# --- Testing (Preview only in Vercel; not needed locally) ---
VERCEL_AUTOMATION_BYPASS_SECRET=FAKE_PLACEHOLDER
